# =======================================================
# TRI-SOPHIAN CODEX — ENVIRONMENT CONFIGURATION
# =======================================================
# The game runs with ZERO API keys. The default engine is the local
# Sovereign Procedural Engine (nvk-local-neural) — fully offline.
# No Google/Gemini key is used anywhere in this project.

# -------------------------------------------------------
# Default AI Model Selection
# -------------------------------------------------------
# Models supported out-of-the-box (no keys needed):
# - nvk-local-neural        (Default - fully offline procedural engine)
# - pollinations-openai     (Open inference, zero-key)
# - pollinations-deepseek   (Open inference, zero-key)
# - ollama-local            (Local Ollama node at http://localhost:11434)
# - custom                  (Custom model id, e.g. ollama:llama3.1)
VITE_AI_MODEL=nvk-local-neural

# -------------------------------------------------------
# Optional: Local Ollama node URL (only used when VITE_AI_MODEL=ollama-local)
# -------------------------------------------------------
VITE_OLLAMA_URL=http://localhost:11434

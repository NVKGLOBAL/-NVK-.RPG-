# =======================================================
# TRI-SOPHIAN CODEX — ENVIRONMENT CONFIGURATION
# =======================================================

# -------------------------------------------------------
# Gemini AI API Key
# -------------------------------------------------------
# Get your API Key from Google AI Studio: https://aistudio.google.com/app/apikey
# Any of the following environment variable names will be automatically detected:
API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------
# Default AI Model Selection
# -------------------------------------------------------
# Pre-configured models supported out-of-the-box:
# - gemini-3.5-flash        (Recommended Default - High speed & intelligence)
# - gemini-3.1-pro-preview   (Deep reasoning & complex code analysis)
# - gemini-flash-latest      (Ultra-fast responses for real-time loops)
# - gemini-3.1-flash-lite    (Lightweight & cost efficient)
# - gemini-2.5-flash         (Standard multimodal Flash)
# - custom                   (Fine-tuned models or custom checkpoints, e.g. tunedModels/...)
VITE_AI_MODEL=gemini-3.5-flash
